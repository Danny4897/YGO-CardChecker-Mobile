{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/block-no-verify-adapter.mjs",
        "matcher": "git commit|git push"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/protect-config-adapter.mjs",
        "matcher": "Write|StrReplace"
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/loop-verifier-nudge.mjs",
        "matcher": "generalPurpose|shell|Task",
        "loop_limit": 2
      }
    ]
  }
}
