{
  "version": 1,
  "name": "ygo-checker",
  "agentsMapPath": "./AGENTS.md",
  "docsDir": "./docs",
  "security": {
    "enabled": true,
    "strict": false,
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/*.spec.ts",
      "**/tools/**"
    ]
  },
  "entropy": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/*.spec.ts",
      "**/tools/**"
    ],
    "autoFix": false
  },
  "architecture": {
    "enabled": false
  },
  "template": {
    "level": "basic",
    "version": 1
  }
}
